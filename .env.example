# 네이버 OpenAPI (검색: 블로그, 뉴스, 쇼핑 등)
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 한국수출입은행 환율 API
# https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2
EXCHANGE_API_KEY=

# 공공데이터포털 (주식, 부동산, 버스 등)
# https://www.data.go.kr
PUBLIC_DATA_PORTAL_API_KEY=

# 서울 열린데이터 광장 (지하철)
# https://data.seoul.go.kr
SEOUL_OPEN_API_KEY=

# 기상청 (날씨)
# https://www.data.go.kr/data/15084084/openapi.do
KMA_WEATHER_API_KEY=

# 금융감독원 전자공시 DART
# https://opendart.fss.or.kr
OPENDART_API_KEY=

# 한국석유공사 오피넷 (유가)
# https://www.opinet.co.kr/user/custapi/custApiInfo.do
OPINET_API_KEY=

# GitHub Personal Access Token (내 저장소 조회, 이슈 생성)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# 국립중앙도서관 추천도서 API
# https://www.nl.go.kr/NL/contents/N31101030000.do
NATIONAL_LIBRARY_API_KEY=

# Pixabay 이미지 검색
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
