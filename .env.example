# Kakao Developers REST API (Daum 검색, 카카오맵 장소 검색)
# https://developers.kakao.com/
KAKAO_REST_API_KEY=

# 한국수출입은행 환율 API
# https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2
EXCHANGE_API_KEY=

# 공공데이터포털 (주식, 부동산, 버스 등)
# https://www.data.go.kr
PUBLIC_DATA_PORTAL_API_KEY=

# 서울 열린데이터 광장 (지하철)
# https://data.seoul.go.kr
SEOUL_OPEN_API_KEY=

# 기상청 (날씨)
# https://www.data.go.kr/data/15084084/openapi.do
KMA_WEATHER_API_KEY=

# 금융감독원 전자공시 DART
# https://opendart.fss.or.kr
OPENDART_API_KEY=

# 한국석유공사 오피넷 (유가)
# https://www.opinet.co.kr/user/custapi/custApiInfo.do
OPINET_API_KEY=

# 국립중앙도서관 추천도서 API
# https://www.nl.go.kr/NL/contents/N31101030000.do
NATIONAL_LIBRARY_API_KEY=

# Pixabay 이미지 검색
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# serve http(SSE, 인터넷 노출) 인증용 공유 비밀키
# 'public-api-mcp config generate-token'으로 생성. 비어 있으면 serve http가 시작을 거부한다.
MCP_AUTH_TOKEN=
